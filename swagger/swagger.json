          },
          "totalPages": {
            "type": "integer",
            "minimum": 0,
            "description": "전체 페이지 수",
            "example": 3
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "API 에러 상세 정보.",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "DUPLICATE_EMAIL",
