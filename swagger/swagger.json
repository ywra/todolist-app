          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 255,
            "description": "비밀번호 (최소 8자, 최대 255자, 영문·숫자·특수문자 각 1자 이상 포함 필수). 허용 특수문자: `!@#$%^&*()_+-=[]{}|;':\",.\\<>?/`",
            "example": "Password1!"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "로그인 요청 바디.",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "등록된 이메일 주소",
            "example": "hong@example.com"
          },
          "password": {
            "type": "string",
            "description": "계정 비밀번호",
            "example": "Password1!"
          }
        }
      },
      "LoginData": {
        "type": "object",
        "description": "로그인 성공 시 반환되는 데이터.",
        "required": ["accessToken", "user"],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT Access Token. 유효기간 1시간. 이후 모든 인증 요청의 `Authorization: Bearer <token>` 헤더에 포함하십시오.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI1NTBlODQwMC1lMjliLTQxZDQtYTcxNi00NDY2NTU0NDAwMDAiLCJpYXQiOjE3NDM0OTI4MDAsImV4cCI6MTc0MzQ5NjQwMH0.signature"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "CreateTodoRequest": {
        "type": "object",
        "description": "할일 등록 요청 바디.",
        "required": ["title", "startDate", "dueDate"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "할일 제목 (1~200자, 공백만으로 구성 불가)",
            "example": "OpenAPI 명세 작성"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true,
            "description": "할일 상세 설명 (선택, 최대 2,000자)",
            "example": "Swagger 3.0 JSON 형식으로 전체 API 명세를 완성한다."
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "할일 시작일 (ISO 8601 날짜 형식, YYYY-MM-DD)",
            "example": "2026-04-01"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "할일 종료일 (ISO 8601 날짜 형식, YYYY-MM-DD). `startDate` 이상이어야 합니다.",
            "example": "2026-04-03"
          }
        }
      },
      "UpdateTodoRequest": {
        "type": "object",
        "description": "할일 수정 요청 바디 (PUT 전체 교체 방식). 모든 필수 필드를 포함하여 전송해야 합니다.",
        "required": ["title", "startDate", "dueDate"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "할일 제목 (1~200자, 공백만으로 구성 불가)",
            "example": "OpenAPI 명세 작성 (수정)"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true,
            "description": "할일 상세 설명 (선택, 최대 2,000자). null 전송 시 설명을 제거합니다.",
            "example": "Swagger 3.0 JSON 형식으로 전체 API 명세를 완성한다. 에러 응답 추가."
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "할일 시작일 (ISO 8601 날짜 형식, YYYY-MM-DD)",
            "example": "2026-04-01"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "할일 종료일 (ISO 8601 날짜 형식, YYYY-MM-DD). `startDate` 이상이어야 합니다.",
            "example": "2026-04-04"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "인증 토큰이 없거나 만료된 경우.",
        "content": {
          "application/json": {
            "schema": {
