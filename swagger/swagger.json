        "description": "에러 응답의 표준 형식.",
        "required": ["success", "error"],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "요청 처리 성공 여부",
            "enum": [false],
            "example": false
          },
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      },
